{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "types": [
      "node",
      "@playwright/test"
    ],
    "baseUrl": ".",
    "paths": {
      "@config/*": ["src/config/*"],
      "@core/*":   ["src/core/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@locators/*": ["src/locators/*"],
      "@pages/*":  ["src/pages/*"],
      "@data/*":   ["src/data/*"],
      "@types/*":  ["src/types/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "allure-results",
    "blob-report",
    "node_modules",
    "playwright-report",
    "test-results",
    "allure-report"
  ]
}
