# Copy this file to stg.env and fill staging values.
# Do not commit real credentials or real keys.

ENVIRONMENT_NAME=stg
APP_DOMAIN=stg.example.com
BASE_URL=https://stg.example.com
API_BASE_URL=https://stg.example.com/api

ADMIN_USERNAME=
ADMIN_PASSWORD=
RECRUITER_USERNAME=
RECRUITER_PASSWORD=
VIEWER_USERNAME=
VIEWER_PASSWORD=

DB_ENABLED=false
DB_CLIENT=postgres
DB_HOST=stg-db.example.com
DB_PORT=5432
DB_NAME=app_stg
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true

API_KEY=
CLIENT_ID=
CLIENT_SECRET=
ENCRYPTION_KEY=

DEFAULT_TIMEOUT_MS=15000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=45000
