# Runtime selector only. Copy to .env and choose the target environment.
# Detailed values are loaded from config/environments/<TEST_ENV>.env
# and can still be overridden by OS-level environment variables / CI secrets.

TEST_ENV=dev
ACCOUNT_PROFILE=admin

# Optional: point to a custom env file, for example:
# ENV_FILE=config/environments/stg.env

# Optional local override examples. Keep real secrets out of git.
# BASE_URL=https://opensource-demo.orangehrmlive.com
# ADMIN_USERNAME=Admin
# ADMIN_PASSWORD=admin123

