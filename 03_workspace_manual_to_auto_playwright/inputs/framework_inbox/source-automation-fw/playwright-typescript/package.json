{
  "name": "playwright-native-ai-framework",
  "version": "2.0.0",
  "private": true,
  "description": "AI-friendly Playwright TypeScript native framework — generate automation from manual test cases.",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "install:browsers": "playwright install --with-deps",
    "test": "playwright test",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:stg": "cross-env TEST_ENV=stg playwright test",
    "test:uat": "cross-env TEST_ENV=uat playwright test",
    "test:prod:smoke": "cross-env TEST_ENV=prod playwright test --grep @smoke --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:generated": "playwright test tests/generated",
    "report": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "codegen": "playwright codegen",
    "validate:ai": "node tools/validate-generated-specs.mjs",
    "new:module": "node tools/create-module.mjs",
    "gen:spec": "node tools/gen-from-json.mjs",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean:reports": "rimraf playwright-report test-results allure-results allure-report blob-report",
    "clean:all": "rimraf playwright-report test-results allure-results allure-report blob-report",
    "clean:hard": "rimraf node_modules playwright-report test-results allure-results allure-report blob-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.0",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.2.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.0",
    "mysql2": "^3.14.0",
    "pg": "^8.13.0",
    "prettier": "^3.5.3",
    "rimraf": "^6.1.3",
    "ssh2": "^1.17.0",
    "typescript": "^5.8.3"
  }
}
