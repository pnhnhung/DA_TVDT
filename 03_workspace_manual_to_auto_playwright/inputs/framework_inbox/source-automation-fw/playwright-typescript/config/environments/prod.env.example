# Production execution should normally be read-only/smoke only.
# Copy this file to prod.env only when the team has approved PROD automation.
# Do not commit real credentials or real keys.

ENVIRONMENT_NAME=prod
APP_DOMAIN=example.com
BASE_URL=https://example.com
API_BASE_URL=https://example.com/api

ADMIN_USERNAME=
ADMIN_PASSWORD=
RECRUITER_USERNAME=
RECRUITER_PASSWORD=
VIEWER_USERNAME=
VIEWER_PASSWORD=

DB_ENABLED=false
DB_CLIENT=postgres
DB_HOST=prod-db.example.com
DB_PORT=5432
DB_NAME=app_prod
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true

API_KEY=
CLIENT_ID=
CLIENT_SECRET=
ENCRYPTION_KEY=

DEFAULT_TIMEOUT_MS=15000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=45000
