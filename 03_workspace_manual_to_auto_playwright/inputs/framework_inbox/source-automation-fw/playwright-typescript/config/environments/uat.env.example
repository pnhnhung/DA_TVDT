# Copy this file to uat.env and fill UAT values.
# Do not commit real credentials or real keys.

ENVIRONMENT_NAME=uat
APP_DOMAIN=uat.example.com
BASE_URL=https://uat.example.com
API_BASE_URL=https://uat.example.com/api

ADMIN_USERNAME=
ADMIN_PASSWORD=
RECRUITER_USERNAME=
RECRUITER_PASSWORD=
VIEWER_USERNAME=
VIEWER_PASSWORD=

DB_ENABLED=false
DB_CLIENT=mysql
DB_HOST=uat-db.example.com
DB_PORT=3306
DB_NAME=app_uat
DB_USERNAME=
DB_PASSWORD=
DB_SSL=true

API_KEY=
CLIENT_ID=
CLIENT_SECRET=
ENCRYPTION_KEY=

DEFAULT_TIMEOUT_MS=15000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=45000
